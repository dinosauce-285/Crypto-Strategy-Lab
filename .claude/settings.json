{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm build*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm test*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm db:generate)",
      "Bash(pnpm commit *)",
      "Bash(pnpm --dir apps/api *)",
      "Bash(pnpm --dir apps/web *)",
      "Bash(pnpm --dir packages/contracts *)",
      "Bash(node .claude/scripts/*)",
      "Bash(node --check *)",
      "Bash(npx prisma generate)",
      "Bash(npx tsc --noEmit*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(ls *)",
      "Bash(tree *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Read(**/.env.example)",
      "Edit(**/.env.example)",
      "Write(**/.env.example)",
      "Bash(pnpm quality)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push*)",
      "Bash(git reset*)",
      "Bash(git rebase*)",
      "Bash(git stash*)",
      "Bash(rm -rf *)",
      "Bash(docker *)",
      "Bash(curl *)",
      "Bash(ssh *)",
      "Bash(gh *)",
      "Bash(pnpm db:migrate*)",
      "Bash(npx prisma migrate*)",
      "Bash(npx prisma db push*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Edit(**/.env)",
      "Write(**/.env)",
      "Read(**/.env.local)",
      "Edit(**/.env.local)",
      "Write(**/.env.local)",
      "Read(**/.env.*.local)",
      "Edit(**/.env.*.local)",
      "Write(**/.env.*.local)",
      "Read(**/.env.development)",
      "Edit(**/.env.development)",
      "Write(**/.env.development)",
      "Read(**/.env.production)",
      "Edit(**/.env.production)",
      "Write(**/.env.production)",
      "Read(**/.env.test)",
      "Edit(**/.env.test)",
      "Write(**/.env.test)",
      "Read(**/.env.key)",
      "Edit(**/.env.key)",
      "Write(**/.env.key)",
      "Read(**/.mcp.json)",
      "Edit(**/.mcp.json)",
      "Write(**/.mcp.json)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Write(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Write(**/*.key)",
      "Read(**/*.p12)",
      "Edit(**/*.p12)",
      "Write(**/*.p12)",
      "Read(**/*.pfx)",
      "Edit(**/*.pfx)",
      "Write(**/*.pfx)",
      "Read(**/*.crt)",
      "Edit(**/*.crt)",
      "Write(**/*.crt)",
      "Read(**/*.jks)",
      "Edit(**/*.jks)",
      "Write(**/*.jks)",
      "Read(**/credentials*.json)",
      "Edit(**/credentials*.json)",
      "Write(**/credentials*.json)",
      "Read(**/service-account*.json)",
      "Edit(**/service-account*.json)",
      "Write(**/service-account*.json)",
      "Read(./secrets/**)",
      "Edit(./secrets/**)",
      "Write(./secrets/**)",
      "Read(**/*.age)",
      "Edit(**/*.age)",
      "Write(**/*.age)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.cjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/user-prompt-submit.cjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/dev-rules-reminder.cjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/scout-block.cjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/bash-security-guard.cjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-format.cjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/decision-reminder.cjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/descriptive-name.cjs\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-init.cjs\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-verify.cjs\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-compact.cjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-notify.cjs\""
          }
        ]
      }
    ]
  }
}
