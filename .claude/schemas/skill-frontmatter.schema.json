{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SKILL.md frontmatter",
  "type": "object",
  "required": ["name", "description"],
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$",
      "description": "kebab-case; must match the skill's directory name"
    },
    "description": {
      "type": "string",
      "minLength": 30,
      "maxLength": 512
    },
    "when_to_use": {
      "type": "string",
      "minLength": 10,
      "maxLength": 240
    },
    "user-invocable": { "type": "boolean" },
    "category": {
      "type": "string",
      "enum": ["debugging", "frontend", "backend", "planning", "release-ops", "devops", "meta"]
    },
    "keywords": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string" }
    },
    "argument-hint": { "type": "string" }
  }
}
