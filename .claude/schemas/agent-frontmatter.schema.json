{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent frontmatter",
  "type": "object",
  "required": ["name", "description", "model", "tools"],
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
    },
    "description": {
      "type": "string",
      "minLength": 30,
      "maxLength": 512
    },
    "model": {
      "type": "string",
      "enum": ["haiku", "sonnet", "opus"]
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "color": { "type": "string" }
  }
}
