# Server-side only. Nothing in this file may ever reach the browser.
# Copy to apps/api/.env and fill in.

# --- Database (ADR 0002) ---
# Uses the Postgres container already running locally (ai_erp_db, port 5432),
# in its own database so nothing is shared but the server process.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crypto_strategy_lab?schema=public"

# --- API ---
API_PORT=3001
WEB_ORIGIN=http://localhost:5173

# --- Redis, for the backtest queue (ADR 0004) ---
# The worker is a second process: `pnpm worker`.
REDIS_URL=redis://localhost:6379
BACKTEST_CONCURRENCY=4
# How long a queue command waits before the API answers 503 instead of hanging.
REDIS_COMMAND_TIMEOUT_MS=3000

# --- Binance (public market-data endpoints need no key) ---
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# --- Groq, for sentiment classification (ADR 0005) ---
# Called once per article at ingest time; scores are stored and never recomputed.
# With no key the module falls back to a keyword heuristic, so the rest still runs.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Optional, shown with the value the code falls back to ---
# Left commented so an unset one is a default rather than drift. Uncomment to override.
#BACKTEST_ATTEMPTS=3
#BINANCE_MAX_RETRIES=10
#BINANCE_INITIAL_BACKOFF_MS=1000
#BINANCE_MAX_BACKOFF_MS=10000
#GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
#CRYPTOCOMPARE_NEWS_URL=https://min-api.cryptocompare.com/data/v2/news/?lang=EN
# Raises the CryptoCompare rate limit. The endpoint works without one.
#CRYPTOCOMPARE_API_KEY=
# Comma-separated. Defaults to the CoinDesk and Cointelegraph feeds.
#RSS_NEWS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss
