# Browser-side. Vite inlines every VITE_* variable into the shipped bundle, so
# everything here is PUBLIC by definition.
#
# Never put a key, a token, a password or a database URL in this file. Those live
# in apps/api/.env and stay on the server.
# Only VITE_-prefixed names are allowed here; the session-start hook flags anything else.

# Where the dev server proxies /api to.
VITE_API_URL=http://localhost:3001
